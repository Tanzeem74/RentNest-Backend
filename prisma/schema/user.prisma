model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  phone          String?
  profilePhoto   String?
  role           Role
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  properties     Property[]
  rentalRequests RentalRequest[]
  reviews        Review[]

  @@map("users")
}
